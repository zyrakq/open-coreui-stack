# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, letsencrypt/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=open-coreui

COMPOSE_EXTENDS=:docker-compose.default.yml #:docker-compose.complex.yml

COMPOSE_FILE=docker-compose.yml${COMPOSE_EXTENDS:-}

# Docker image
COMPLEX_IMAGE=localhost/open-coreui
BACKEND_IMAGE=localhost/open-coreui-backend
FRONTEND_IMAGE=localhost/open-coreui-frontend

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# Backend
PORT=8168
DATABASE_URL=sqlite:///app/data/database.sqlite3
UPLOAD_DIR=/app/data/uploads
WEBUI_SECRET_KEY=B7qrb5MN9NOknfeKcwwO2Q== # WebUI secret key for session management
# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=8168
VIRTUAL_HOST=chat.example.com

# Let's Encrypt SSL certificate domain
LETSENCRYPT_HOST=chat.example.com

# Email for Let's Encrypt certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com